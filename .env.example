# Set these in the Netlify site settings (Site configuration -> Environment variables).
# Never commit a populated .env file. .env is in .gitignore.

# HubSpot Forms API — primary destination for signups
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# Optional. The subscriptionTypeId for the marketing communications consent.
# If you do not know it, leave blank and the function will use 999 as a placeholder.
HUBSPOT_SUBSCRIPTION_TYPE_ID=

# Resend — backup forwarder email
RESEND_API_KEY=
# Must be a verified sender on a domain you own in Resend
FORWARDER_FROM_EMAIL=beta@lingolinq.com
FORWARDER_TO_EMAIL=info@lingolinq.com
